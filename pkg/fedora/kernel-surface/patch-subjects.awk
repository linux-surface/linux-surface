# Print the subjects (without the [PATCH] prefix) of the commits in a patch
# file generated by git format-patch, one per line.
#
# Usage: awk -f patch-subjects.awk <patch>

function flush() {
    if (s != "")
        print s
    s = ""
}

/^Subject: / {
    flush()
    s = $0
    sub(/^Subject: (\[[^]]*\] *)?/, "", s)
    next
}

# Folded subject lines
s != "" && /^ / {
    s = s $0
    next
}

{
    flush()
}

END {
    flush()
}
