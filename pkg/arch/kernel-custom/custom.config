##
## Your kernel config changes, merged after config.x86_64, surface.config and
## arch.config. One option per line, same format as .config, e.g.:
##
##   CONFIG_SOME_DRIVER=m
##   # CONFIG_SOME_FEATURE is not set
##
## Keep it short: anything not listed here comes from the linux-surface config.
##

## IPU3 cameras (Surface Pro 4/5/6, Surface Book 1/2): already enabled by
## surface.config; listed so they stay on even if that file changes.
CONFIG_VIDEO_IPU3_CIO2=m
CONFIG_VIDEO_IPU3_IMGU=m
CONFIG_IPU_BRIDGE=m
CONFIG_INTEL_SKL_INT3472=m
CONFIG_VIDEO_OV5693=m
CONFIG_VIDEO_OV8865=m
CONFIG_VIDEO_OV7251=m
CONFIG_LEDS_CLASS=y

## S0ix residency counters for surface-pro-5-suspend.sh --test
CONFIG_INTEL_PMC_CORE=m
