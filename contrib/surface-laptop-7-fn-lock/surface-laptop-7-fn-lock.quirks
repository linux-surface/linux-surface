# Surface Laptop 7 15-inch: the SAM HID keyboard (Microsoft Surface 045E:006C)
# reports SystemFunctionShift while Fn lock is on; the kernel maps that to
# BTN_0 and holds it. libinput forwards it as a pointer button and KWin keeps
# the pointer focus frozen, so clicks land in the last focused window.
#
# The generic "Microsoft Surface Keyboard" quirk already drops BTN_0 for the
# USB HID Surface keyboards, but its MatchName requires the word "Keyboard",
# which the SAM HID name does not contain.
#
# https://gitlab.freedesktop.org/libinput/libinput/-/issues/1251
# https://bugs.kde.org/show_bug.cgi?id=515288

[Microsoft Surface Laptop 7 Keyboard]
MatchName=Microsoft Surface 045E:006C
MatchDMIModalias=dmi:*:svnMicrosoftCorporation:*
AttrEventCode=-BTN_0;
AttrKeyboardIntegration=internal
