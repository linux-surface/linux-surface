[Unit]
Description=Publish greeter Wayland env for Chrome Remote Desktop attach
After=display-manager.service
ConditionPathExists=/usr/bin/loginctl

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/crd-publish-greeter.sh

[Install]
WantedBy=multi-user.target
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
