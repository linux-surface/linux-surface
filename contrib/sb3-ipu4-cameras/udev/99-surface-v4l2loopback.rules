# Front-Standard = lowest loopback (video60) — default V4L2/Chrome/Firefox/Edge.
# IR without :capture: and without uaccess — Howdy force-disabled, do not enumerate.
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Front-Standard", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Front-Standard"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Front-HQ", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Front-HQ"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Front-Fast", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Front-Fast"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Back-Standard", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Back-Standard"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Back-HQ", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Back-HQ"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Back-Fast", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Back-Fast"
# Legacy 3-device labels (upgrade path)
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Front", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Front"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Back", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Back"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-IR-Howdy", GROUP="root", MODE="0600", TAG-="uaccess", ENV{ID_V4L_PRODUCT}="Surface-IR-Howdy", ENV{ID_V4L_CAPABILITIES}=":", ENV{PIPEWIRE_IGNORE}="1"
