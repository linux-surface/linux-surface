# Front = lowest loopback (video60) — default V4L2/Chrome/Firefox/Edge.
# IR without :capture: and without uaccess — Howdy force-disabled, do not enumerate.
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Front", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Front"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-Back", GROUP="video", MODE="0666", TAG+="uaccess", ENV{ID_V4L_CAPABILITIES}=":capture:", ENV{ID_V4L_PRODUCT}="Surface-Back"
SUBSYSTEM=="video4linux", ATTR{name}=="Surface-IR-Howdy", GROUP="root", MODE="0600", TAG-="uaccess", ENV{ID_V4L_PRODUCT}="Surface-IR-Howdy", ENV{ID_V4L_CAPABILITIES}=":", ENV{PIPEWIRE_IGNORE}="1"
