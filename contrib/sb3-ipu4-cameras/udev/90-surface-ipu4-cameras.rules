# Raw IPU — root only (webcamd). TAG-=uaccess: logind must not attach a user ACL.
# Without this Firefox/Edge opened /dev/video0 as default and hung the display.
ACTION=="add|change", SUBSYSTEM=="video4linux", DEVPATH=="*intel-ipu*", \
  GROUP="root", MODE="0600", TAG-="uaccess", \
  ENV{ID_V4L_PRODUCT}="Intel-IPU4", ENV{ID_V4L_CAPABILITIES}=":", \
  ENV{PIPEWIRE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0"
ACTION=="add|change", SUBSYSTEM=="video4linux", ATTR{name}=="Intel IPU*", \
  GROUP="root", MODE="0600", TAG-="uaccess", \
  ENV{ID_V4L_PRODUCT}="Intel-IPU4", ENV{ID_V4L_CAPABILITIES}=":", \
  ENV{PIPEWIRE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0"
ACTION=="add|change", SUBSYSTEM=="media", DEVPATH=="*intel-ipu*", \
  GROUP="root", MODE="0600", TAG-="uaccess"
ACTION=="add|change", SUBSYSTEM=="media", KERNEL=="media[0-9]*", DEVPATH=="*ipu*", \
  GROUP="root", MODE="0600", TAG-="uaccess"
# CSI/subdev nodes: opening them from guvcview/PipeWire can SIGSEGV on S_FMT.
ACTION=="add|change", SUBSYSTEM=="video4linux", KERNEL=="v4l-subdev*", \
  GROUP="root", MODE="0600", TAG-="uaccess", ENV{PIPEWIRE_IGNORE}="1"
