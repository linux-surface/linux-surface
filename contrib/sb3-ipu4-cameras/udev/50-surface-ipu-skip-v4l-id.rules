# Surface Book 3: do not run v4l_id on PCI IPU (8086:8a19).
# last_rule is ignored in systemd-udevd ≥256 — skip lives in
# 60-persistent-v4l.rules (override under /etc).
ACTION=="add|change", SUBSYSTEM=="video4linux", DEVPATH=="*intel-ipu*", \
  ENV{ID_V4L_PRODUCT}="Intel-IPU4", ENV{ID_V4L_CAPABILITIES}=":", ENV{ID_MM_CANDIDATE}="0"
