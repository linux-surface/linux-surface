[Unit]
Description=Surface Book 3 IPU4 late init (GPIO, INT3472, cameras)
DefaultDependencies=yes
After=display-manager.service systemd-modules-load.service local-fs.target
ConditionKernelVersion=*surface-ipu4*

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/surface-ipu4-late.sh
RemainAfterExit=yes
# BOOT_LOAD+AUTH + sensors — 55 s used to kill CSE mid-way
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
