[Unit]
Description=Watch for Surface Face Login button request
ConditionKernelVersion=*surface-ipu4*
After=plasmalogin.service display-manager.service

[Path]
PathExists=/run/surface-howdy/face-request
PathModified=/run/surface-howdy/face-request
Unit=surface-face-login.service

[Install]
WantedBy=multi-user.target
