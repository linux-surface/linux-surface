[Unit]
Description=Enable Howdy PAM after Surface webcamd is ready
After=surface-webcam.service surface-ipu4-late.service
Wants=surface-webcam.service

[Service]
Type=oneshot
ExecStart=/bin/rm -f /etc/howdy/force-disabled
ExecStart=/usr/local/sbin/surface-howdy-gate.sh --enable
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
