[Unit]
Description=Hide Surface/IPU V4L2 Devices from PipeWire (Discord SEGV workaround)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/surface-pw-hide-loopbacks.sh
RemainAfterExit=no

[Install]
WantedBy=default.target
