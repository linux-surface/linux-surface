[Unit]
Description=Surface cameras → PipeWire Video/Source (all 6 RGB)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/surface-pw-publish
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
