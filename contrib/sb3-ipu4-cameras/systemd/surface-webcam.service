[Unit]
Description=Surface Book 3 live webcams (IPU4 → v4l2loopback, no placeholders)
After=surface-ipu4-late.service systemd-modules-load.service systemd-udevd.service display-manager.service
Wants=surface-ipu4-late.service
ConditionKernelVersion=*surface-ipu4*
ConditionPathExists=/dev/video60
ConditionPathExists=/dev/media0
ConditionPathExists=/dev/video10
ConditionPathExists=/run/surface-howdy/cameras-ready
StartLimitBurst=2
StartLimitIntervalSec=60

[Service]
Type=simple
User=root
Group=video
RuntimeDirectory=surface-webcam
RuntimeDirectoryMode=0755
Environment=PYTHONPATH=/opt/surface-cameras/lib
EnvironmentFile=-/etc/default/surface-webcam
EnvironmentFile=-/etc/sysconfig/surface-webcam
ExecStart=/usr/bin/python3 -u /opt/surface-cameras/tools/surface_webcamd.py
Restart=on-failure
RestartSec=8
Nice=-5
KillSignal=SIGTERM
TimeoutStopSec=12
KillMode=process

[Install]
WantedBy=multi-user.target
