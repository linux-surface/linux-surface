[Unit]
Description=Surface Face Login (on-demand Howdy via greeter button)
ConditionKernelVersion=*surface-ipu4*
After=surface-webcam.service surface-ipu4-late.service
Wants=surface-webcam.service
# Never order the greeter after this unit.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/surface-face-login.sh
Nice=-5
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
