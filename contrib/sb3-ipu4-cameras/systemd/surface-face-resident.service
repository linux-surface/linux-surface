[Unit]
Description=Howdy face models, ready before the password is submitted
After=local-fs.target
# Must not be Before=plasmalogin. That ordering held the greeter.

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/face-resident.py
Restart=on-failure
RestartSec=2
TimeoutStartSec=10

[Install]
WantedBy=multi-user.target
