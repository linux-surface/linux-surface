[Unit]
Description=Surface Face Login button on greeter (surface-ipu4 only)
ConditionKernelVersion=*surface-ipu4*
ConditionDirectoryNotEmpty=/etc/howdy/models
After=plasmalogin.service display-manager.service
# Never Before=/After= camera units — greeter must stay instant.

[Service]
Type=simple
ExecStart=/usr/local/sbin/surface-face-greeter-button-launch.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=15

[Install]
WantedBy=graphical.target
