+		for (i = 0; i < nlanes; i++) {
+			writel(timing->dtermen,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(i));
+			writel(timing->dsettle,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(i));
+		}
+		break;
+	case 4: /* CIO2-ish 0x570 */
