From 580ced63d438e767904eb86ace3480dbab273ff7 Mon Sep 17 00:00:00 2001
From: surface-ipu4 <surface-ipu4@localhost>
Date: Mon, 2 Nov 2026 23:26:23 +0100
Subject: [PATCH] media: ipu6: SB3 CSI BB8 + lane-safe front timing
 (regenerated)

---
 .../media/pci/intel/ipu6/ipu4p-isys-csi-phy.c | 198 ++++++++++++++++--
 1 file changed, 183 insertions(+), 15 deletions(-)

diff --git a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c
index 6016e46b1..61aeada50 100644
--- a/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c
+++ b/drivers/media/pci/intel/ipu6/ipu4p-isys-csi-phy.c
@@ -3,8 +3,11 @@
 
 #include <linux/bitfield.h>
 #include <linux/bits.h>
+#include <linux/delay.h>
 #include <linux/errno.h>
 #include <linux/io.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
 
 #include "ipu6.h"
 #include "ipu6-bus.h"
@@ -24,8 +27,11 @@ struct ipu4p_phy_bb_config {
 
 static const struct ipu4p_phy_bb_config ipu4p_phy_bb_configs[] = {
 	{ 4, 13, 32, 0x0f },
+	/* SB3: CSI-2 0 / ov8865 Back → bb 6 */
 	{ 6, 13, 32, 0x15 },
-	/* BB10 is part of the verified IPU4P PHY baseline. */
+	/* SB3: CSI-2 1 / ov7251 IR → bb 8 (was missing → IR 0 frames) */
+	{ 8, 13, 32, 0x15 },
+	/* SB3: CSI-2 2 / ov5693 Front → bb 10 */
 	{ 10, 13, 32, 0x15 },
 	{ 12, 13, 32, 0x0f },
 	{ 14, 13, 32, 0x15 },
@@ -70,18 +76,92 @@ void ipu4p_isys_phy_setup(struct ipu6_isys *isys)
 }
 
 /*
- * Use fixed timing observed in Windows for the SP7 front camera:
- * IPU4P CSI-2 port 2, firmware source 7, two-lane D-PHY.
+ * Windows ConfigMipiClk on SB3/SP7: +0x34=1155, +0x3c=1269
+ * (= TERMEN_DLANE0 / TERMEN_DLANE1). Do NOT smash lanes 2..8 — that walks
+ * past DLANE3 and destabilizes ISYS on SB3 (white/black/0-frame captures).
  */
 static void ipu4p_isys_apply_fixed_2lane_timing(struct ipu6_isys_csi2 *csi2)
 {
 	writel(0, csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_CLANE);
+
 	writel(1155, csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(0));
+	writel(0, csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(0));
+
+	writel(1269, csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(1));
+	writel(0, csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(1));
+}
+
+/*
+ * Front (port 2) timing modes (module param sb3_front_timing):
+ *  0 = SETTLE 1155/1269 + calc TERMEN (previous default)
+ *  1 = Windows TERMEN 1155/1269 + settle 0 (same as IR/back)
+ *  2 = SETTLE=calc, TERMEN=Windows
+ *  3 = pure calculated (no override)
+ *  4 = SETTLE 0x570/0x570 (CIO2-style) + calc TERMEN
+ */
+static unsigned int sb3_front_timing = 0;
+module_param(sb3_front_timing, uint, 0644);
+MODULE_PARM_DESC(sb3_front_timing,
+		 "SB3 front CSI timing mode 0..4 (see ipu4p-isys-csi-phy.c)");
+
+/* 6.19.8-3 SETTLE_CLANE/DLANE. 880/1400 locks but CRC-glitches;
+ * 1400/880 is non-recoverable on this SB3.
+ */
+static unsigned int sb3_front_clk_settle = 1400;
+module_param(sb3_front_clk_settle, uint, 0644);
+static unsigned int sb3_front_data_settle = 880;
+module_param(sb3_front_data_settle, uint, 0644);
+
+static void ipu4p_isys_apply_front_timing(struct ipu6_isys_csi2 *csi2,
+					  unsigned int nlanes,
+					  const struct ipu6_isys_csi2_timing *timing)
+{
+	unsigned int i;
+	unsigned int mode = sb3_front_timing;
+	unsigned int cset = sb3_front_clk_settle;
+	unsigned int dset = sb3_front_data_settle;
 
-	for (unsigned int i = 0; i < 8; i++) {
-		writel(0, csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(i));
-		writel(1269,
-		       csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(i + 1));
+	if (nlanes < 1 || nlanes > 2)
+		nlanes = 2;
+
+	switch (mode) {
+	case 1: /* Windows TERMEN only */
+		ipu4p_isys_apply_fixed_2lane_timing(csi2);
+		break;
+	case 2: /* calc settle + Windows TERMEN on data lanes */
+		writel(timing->csettle,
+		       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_CLANE);
+		writel(1155, csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(0));
+		writel(timing->dsettle,
+		       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(0));
+		writel(1269, csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(1));
+		if (nlanes > 1)
+			writel(timing->dsettle,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(1));
+		break;
+	case 3: /* pure calc */
+		writel(timing->csettle,
+		       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_CLANE);
+		for (i = 0; i < nlanes; i++) {
+			writel(timing->dtermen,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(i));
+			writel(timing->dsettle,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(i));
+		}
+		break;
+	case 4: /* CIO2-ish 0x570 */
+		cset = dset = 0x570;
+		fallthrough;
+	case 0:
+	default:
+		writel(cset, csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_CLANE);
+		for (i = 0; i < nlanes; i++) {
+			writel(timing->dtermen,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_DLANE(i));
+			writel(dset,
+			       csi2->base + IPU4P_CSI2_RX_DLY_CNT_SETTLE_DLANE(i));
+		}
+		break;
 	}
 }
 
@@ -125,6 +205,53 @@ static void ipu4p_isys_csi_irq_disable(struct ipu6_isys *isys,
 	writel(0xffffffff, base + offset0 + IPU4P_ISYS_IRQ_CLEAR_OFFSET);
 }
 
+static unsigned int ipu4p_csi2_bb(unsigned int port)
+{
+	switch (port) {
+	case 0:
+		return 6; /* ov8865 back */
+	case 1:
+		return 8; /* ov7251 IR */
+	case 2:
+		return 10; /* ov5693 front */
+	default:
+		return 0;
+	}
+}
+
+/*
+ * Leftover HS survives STREAMOFF (front often 0x302). The next STREAMON
+ * then logs DPHY non-recoverable sync and delivers a saturated frame.
+ * 6.19 cleared it with a long AFE-off, not a DLL rewrite.
+ */
+static void ipu4p_csi2_pulse_afe(struct ipu6_isys *isys,
+				  struct ipu6_isys_csi2 *csi2)
+{
+	void __iomem *isp_base = isys->adev->isp->base;
+	unsigned int bb = ipu4p_csi2_bb(csi2->port);
+	u32 cfg;
+
+	if (!isp_base || !bb)
+		return;
+
+	writel(0, csi2->base + IPU4P_CSI2_RX_ENABLE);
+	cfg = readl(csi2->base + IPU4P_CSI2_RX_CONFIG);
+	writel(0, csi2->base + IPU4P_CSI2_RX_CONFIG);
+	writel(0, isp_base + IPU4P_BUTTRESS_REG_BBX_AFE_CONFIG(bb));
+	usleep_range(8000, 10000);
+	writel(0, csi2->base + IPU4P_CSI2_RX_STATUS_DLANE_HS);
+	writel(0, csi2->base + IPU4P_CSI2_RX_STATUS_DLANE_LP);
+	usleep_range(5000, 7000);
+	writel(0, csi2->base + IPU4P_CSI2_RX_STATUS_DLANE_HS);
+	writel(0, csi2->base + IPU4P_CSI2_RX_STATUS_DLANE_LP);
+	writel(0x15 | (2 << 29), isp_base + IPU4P_BUTTRESS_REG_BBX_AFE_CONFIG(bb));
+	usleep_range(3000, 5000);
+	writel(cfg, csi2->base + IPU4P_CSI2_RX_CONFIG);
+	dev_info(&isys->adev->auxdev.dev, "csi2-%u: AFE pulse bb%u hs=0x%x\n",
+		 csi2->port, bb,
+		 readl(csi2->base + IPU4P_CSI2_RX_STATUS_DLANE_HS));
+}
+
 /* IPU4P PHY building blocks remain configured until the ISYS power cycle. */
 int ipu4p_isys_phy_set_power(struct ipu6_isys *isys,
 			     struct ipu6_isys_csi2_config *cfg,
@@ -134,7 +261,6 @@ int ipu4p_isys_phy_set_power(struct ipu6_isys *isys,
 	struct ipu6_isys_csi2 *csi2;
 	void __iomem *base;
 	u32 value;
-	bool fixed_timing;
 
 	if (!cfg || cfg->port >= isys->pdata->ipdata->csi2.nports)
 		return -EINVAL;
@@ -148,6 +274,14 @@ int ipu4p_isys_phy_set_power(struct ipu6_isys *isys,
 			   IPU4P_CSI2_RX_CONFIG_RELEASE_LP11);
 		writel(value, base + IPU4P_CSI2_RX_CONFIG);
 		writel(0, base + IPU4P_CSI2_RX_ENABLE);
+		/*
+		 * 6.19: leftover HS on the front (often 0x302) and IR (0x101)
+		 * survives STREAMOFF. The next STREAMON then reports DPHY
+		 * non-recoverable sync and delivers a saturated frame.
+		 * Port 0 (back) is not pulsed — that link is already stable.
+		 */
+		if (csi2->port == 1 || csi2->port == 2)
+			ipu4p_csi2_pulse_afe(isys, csi2);
 
 		ipu4p_isys_csi_irq_disable(isys, cfg->port);
 
@@ -167,18 +301,52 @@ int ipu4p_isys_phy_set_power(struct ipu6_isys *isys,
 	       base + IPU4P_CSI2_RX_DLY_CNT_TERMEN_CLANE);
 
 	/*
-	 * SB3 (and SP7 front): calculated settle never locks reliably on
-	 * IPU4P CSI-2. Use Windows-observed 1155/1269 ticks for the three
-	 * sensor ports: 0=back ov8865, 1=IR ov7251, 2=front ov5693.
+	 * SB3 ports: 0=back ov8865, 1=IR ov7251, 2=front ov5693.
+	 * IR/back: Windows TERMEN 1155/1269. Front: SETTLE 1155/1269
+	 * (TERMEN path and calc settle both DPHY-desync → white frames).
 	 */
-	fixed_timing = csi2->port <= 2 && cfg->nlanes >= 1 && cfg->nlanes <= 2;
-	if (fixed_timing) {
+	if (csi2->port <= 1 && cfg->nlanes >= 1 && cfg->nlanes <= 2) {
+		/*
+		 * Pulse only a dirty IR link. A pulse while hs==0 holds RX
+		 * off for ~15 ms and breaks LP→HS (6.19).
+		 */
+		if (csi2->port == 1) {
+			u32 hs = readl(base + IPU4P_CSI2_RX_STATUS_DLANE_HS);
+
+			if (hs)
+				ipu4p_csi2_pulse_afe(isys, csi2);
+		}
 		ipu4p_isys_apply_fixed_2lane_timing(csi2);
 		dev_info(&isys->adev->auxdev.dev,
-			 "SB3/SP7 fixed CSI timing for port %u lanes=%u src=%u\n",
+			 "SB3/SP7 fixed CSI TERMEN for port %u lanes=%u src=%u\n",
 			 csi2->port, cfg->nlanes, csi2->asd.source);
+		writel(cfg->nlanes, base + IPU4P_CSI2_RX_NOF_ENABLED_LANES);
+	} else if (csi2->port == 2 && cfg->nlanes >= 1 && cfg->nlanes <= 2) {
+		void __iomem *isp_base = isys->adev->isp->base;
+		u32 hs, rxctl;
+		unsigned int bb = 10;
+
+		/*
+		 * 6.19 SB3: pulse AFE only when leftover HS is latched.
+		 * A clean link (hs==0) must not be pulsed.
+		 */
+		hs = readl(base + IPU4P_CSI2_RX_STATUS_DLANE_HS);
+		if (hs) {
+			dev_info(&isys->adev->auxdev.dev,
+				 "csi2-2: leftover hs=0x%x → AFE pulse\n", hs);
+			ipu4p_csi2_pulse_afe(isys, csi2);
+		}
 
-		/* Windows configures the lane count before RX_CONFIG. */
+		/* 6.19 SB3: ev_correction on bb10 every STREAMON */
+		rxctl = readl(isp_base + IPU4P_BUTTRESS_REG_CPHYX_RX_CONTROL1(bb));
+		rxctl |= 0x380078 | BIT(31);
+		writel(rxctl, isp_base + IPU4P_BUTTRESS_REG_CPHYX_RX_CONTROL1(bb));
+
+		ipu4p_isys_apply_front_timing(csi2, cfg->nlanes, timing);
+		dev_info(&isys->adev->auxdev.dev,
+			 "SB3 front CSI mode=%u settle=%u/%u csettle_calc=%u ev=0x%x\n",
+			 sb3_front_timing, sb3_front_clk_settle,
+			 sb3_front_data_settle, timing->csettle, rxctl);
 		writel(cfg->nlanes, base + IPU4P_CSI2_RX_NOF_ENABLED_LANES);
 	} else {
 		writel(timing->csettle,
-- 
