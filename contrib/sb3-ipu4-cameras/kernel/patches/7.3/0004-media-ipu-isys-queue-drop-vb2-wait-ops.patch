From 7f9e30e94b2e5905d544de5cc8c0d48c4510f7d5 Mon Sep 17 00:00:00 2001
From: popos123 <popos123@users.noreply.github.com>
Date: Tue, 20 Oct 2026 00:00:34 +0200
Subject: [PATCH] media: ipu-isys-queue: drop vb2 wait_prepare/wait_finish for
 7.x

---
 drivers/media/pci/intel/ipu-isys-queue.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/media/pci/intel/ipu-isys-queue.c b/drivers/media/pci/intel/ipu-isys-queue.c
index ee735487b..6bdaea972 100644
--- a/drivers/media/pci/intel/ipu-isys-queue.c
+++ b/drivers/media/pci/intel/ipu-isys-queue.c
@@ -1379,8 +1379,7 @@ void ipu_isys_req_queue(struct media_request *req)
 
 struct vb2_ops ipu_isys_queue_ops = {
 	.queue_setup = queue_setup,
-	.wait_prepare = ipu_isys_queue_unlock,
-	.wait_finish = ipu_isys_queue_lock,
+	/* wait_prepare/wait_finish removed from vb2_ops in Linux 7.x */
 	.buf_init = buf_init,
 	.buf_prepare = buf_prepare,
 	.buf_finish = buf_finish,
-- 
2.56.0

