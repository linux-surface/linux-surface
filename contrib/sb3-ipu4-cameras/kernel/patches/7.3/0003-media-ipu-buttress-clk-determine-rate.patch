From b6d7a4030914f8dabeb44f711dfe4e12b5690f3f Mon Sep 17 00:00:00 2001
From: popos123 <popos123@users.noreply.github.com>
Date: Mon, 19 Oct 2026 23:56:58 +0200
Subject: [PATCH] media: ipu-buttress: replace clk round_rate with
 determine_rate

---
 drivers/media/pci/intel/ipu-buttress.c | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/drivers/media/pci/intel/ipu-buttress.c b/drivers/media/pci/intel/ipu-buttress.c
index c5d5247eb..45fba518b 100644
--- a/drivers/media/pci/intel/ipu-buttress.c
+++ b/drivers/media/pci/intel/ipu-buttress.c
@@ -1071,19 +1071,21 @@ static void ipu_buttress_clk_disable(struct clk_hw *hw)
 	writel(val, ck->isp->base + BUTTRESS_REG_SENSOR_CLK_CTL);
 }
 
-static long ipu_buttress_clk_round_rate(struct clk_hw *hw,
-					unsigned long rate,
-					unsigned long *parent_rate)
+static int ipu_buttress_clk_determine_rate(struct clk_hw *hw,
+					   struct clk_rate_request *req)
 {
 	unsigned long best = ULONG_MAX;
 	unsigned long round_rate = 0;
+	unsigned long rate = req->rate;
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(sensor_clk_freqs); i++) {
 		long diff = sensor_clk_freqs[i].rate - rate;
 
-		if (diff == 0)
-			return rate;
+		if (diff == 0) {
+			req->rate = rate;
+			return 0;
+		}
 
 		diff = abs(diff);
 		if (diff < best) {
@@ -1092,7 +1094,8 @@ static long ipu_buttress_clk_round_rate(struct clk_hw *hw,
 		}
 	}
 
-	return round_rate;
+	req->rate = round_rate;
+	return 0;
 }
 
 static unsigned long
@@ -1134,7 +1137,7 @@ static const struct clk_ops ipu_buttress_clk_sensor_ops_parent = {
 	.disable = ipu_buttress_clk_pll_disable,
 	.prepare = ipu_buttress_clk_pll_prepare,
 	.unprepare = ipu_buttress_clk_pll_unprepare,
-	.round_rate = ipu_buttress_clk_round_rate,
+	.determine_rate = ipu_buttress_clk_determine_rate,
 	.recalc_rate = ipu_buttress_clk_recalc_rate,
 	.set_rate = ipu_buttress_clk_set_rate,
 };
-- 
