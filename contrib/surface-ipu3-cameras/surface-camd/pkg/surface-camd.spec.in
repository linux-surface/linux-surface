# Fedora package for surface-camd. Generated by install.sh, which fills in
# @VERSION@.
%global debug_package %{nil}

Name:           surface-camd
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Userspace driver for the IPU3 front, rear and IR cameras on Surface devices
License:        GPL-2.0-or-later
URL:            https://github.com/linux-surface/linux-surface
Source0:        surface-camd-%{version}.tar.gz
BuildRequires:  gcc
BuildRequires:  make
# v4l2loopback is in RPM Fusion, so it can't be a hard dependency.
Recommends:     v4l2loopback

%description
surface-camd captures raw data from the IPU3 CIO2 on Surface Pro 4/5/6 and
Surface Book 1/2, processes it in software and publishes the front, rear and
IR cameras as v4l2loopback webcams. It does not need libcamera.

%prep
%autosetup -n surface-camd-%{version}

%build
cd surface-camd
%make_build CFLAGS="%{optflags}" LDFLAGS="%{?build_ldflags}"

%check
cd surface-camd
make test CFLAGS="%{optflags}"

%install
cd surface-camd
make install DESTDIR=%{buildroot} PREFIX=/usr \
	SYSTEMDUNITDIR=/usr/lib/systemd/system \
	MODPROBEDIR=/usr/lib/modprobe.d \
	MODULESLOADDIR=/usr/lib/modules-load.d

%files
/usr/bin/surface-camd
/usr/lib/systemd/system/surface-camd@.service
/usr/lib/modprobe.d/v4l2loopback-surface.conf
/usr/lib/modprobe.d/surface-ipu3-cameras.conf
/usr/lib/modules-load.d/v4l2loopback-surface.conf
/usr/share/wireplumber/wireplumber.conf.d/51-surface-ipu3-cameras.conf
/usr/share/doc/surface-camd/
