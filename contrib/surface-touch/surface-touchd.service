[Unit]
Description=Surface touchscreen and pen service (gestures and API)
Documentation=file:///usr/share/doc/surface-touch/README.md
# Works on top of iptsd's input devices; it waits for them if iptsd starts later.
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=@BINDIR@/surface-touchd
RuntimeDirectory=surface-touchd
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
