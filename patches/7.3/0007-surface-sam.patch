From 9d0f5845ba2a6954e37d5e4d63910013333c109f Mon Sep 17 00:00:00 2001
From: Lars Schellhas van Kisfeld
 <lars.schellhas-van-kisfeld@schellhasconsulting.de>
Date: Mon, 16 Nov 2026 21:20:45 +0100
Subject: [PATCH] power: supply: surface_charger: Add the adapter rating

The EC also reports the power rating of the connected adapter (DPTF
ARTG, command 0x0f), next to the power source (PSRC, 0x0d) that the
driver already reads. Expose it as dptf/adapter_rating_mw on the AC
device, with the name and unit of the DPTF power participant
(drivers/acpi/dptf/dptf_power.c, INT3407). The group name is neutral on
purpose: the driver does not implement that participant's interface.
Reading it fails with ENODATA while the EC reports no known rating. The
driver requests the value on every read and caches nothing, so it is
never stale after resume.

An EC that does not support the command does not answer the request and
the request runs into a timeout, so the driver cannot use the request to
find out about the support. It creates the attribute only on devices
that have the "has_dptf" device property, which the Surface Aggregator
registry sets for the devices that support it, and sends no request
otherwise.

Tested on a Surface Book 3 (15", i7-1065G7, 7.3.4-1-surface) with the
three patches built out of tree: it reads 120000 with the Surface PSU,
matching the raw EC data read through the SSAM debug device, and 65000
while only a 65 W USB-C charger was connected.

The analysis, the patch and this changelog were prepared with the help
of an AI coding assistant (Claude, Anthropic). I reviewed the change.

Link: https://github.com/linux-surface/surface-aggregator-module/issues/29
Signed-off-by: Lars Schellhas van Kisfeld <lars.schellhas-van-kisfeld@schellhasconsulting.de>
Patchset: surface-sam
---
 .../ABI/testing/sysfs-class-power-surface     | 13 ++++
 drivers/power/supply/surface_charger.c        | 60 +++++++++++++++++++
 2 files changed, 73 insertions(+)

diff --git a/Documentation/ABI/testing/sysfs-class-power-surface b/Documentation/ABI/testing/sysfs-class-power-surface
index 739cbb5ee..176533cd3 100644
--- a/Documentation/ABI/testing/sysfs-class-power-surface
+++ b/Documentation/ABI/testing/sysfs-class-power-surface
@@ -105,3 +105,16 @@ Description:
 		controller is known to provide the data.
 
 		Access: Read
+
+What:		/sys/class/power_supply/<supply_name>/dptf/adapter_rating_mw
+Date:		November 2026
+KernelVersion:	7.4
+Contact:	Lars Schellhas van Kisfeld <lars.schellhas-van-kisfeld@schellhasconsulting.de>
+Description:
+		Power rating of the connected adapter, in mW (DPTF ARTG), as
+		reported by the embedded controller. Reading it fails with
+		ENODATA while no rating is known. The attribute is only present
+		on devices whose embedded controller is known to provide the
+		value.
+
+		Access: Read
diff --git a/drivers/power/supply/surface_charger.c b/drivers/power/supply/surface_charger.c
index d4bba6b41..e397a0c98 100644
--- a/drivers/power/supply/surface_charger.c
+++ b/drivers/power/supply/surface_charger.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/power_supply.h>
+#include <linux/property.h>
 #include <linux/types.h>
 
 #include <linux/surface_aggregator/device.h>
@@ -40,6 +41,15 @@ SSAM_DEFINE_SYNC_REQUEST_CL_R(ssam_bat_get_psrc, __le32, {
 });
 
 
+/* Get the power rating of the connected adapter (DPTF ARTG), in mW. */
+SSAM_DEFINE_SYNC_REQUEST_CL_R(ssam_bat_get_artg, __le32, {
+	.target_category = SSAM_SSH_TC_BAT,
+	.command_id      = 0x0f,
+});
+
+/* ARTG value while no rating is known (e.g. no adapter connected). */
+#define SPWR_AC_ARTG_UNKNOWN		0x80000000
+
 /* -- Device structures. ---------------------------------------------------- */
 
 struct spwr_psy_properties {
@@ -59,6 +69,7 @@ struct spwr_ac_device {
 	struct mutex lock;  /* Guards access to state below. */
 
 	__le32 state;
+	bool has_artg;	/* the device supports the ARTG request (device property) */
 };
 
 
@@ -164,6 +175,48 @@ static int spwr_ac_get_property(struct power_supply *psy, enum power_supply_prop
 }
 
 
+/* -- DPTF attributes. ------------------------------------------------------ */
+
+static ssize_t adapter_rating_mw_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct spwr_ac_device *ac = power_supply_get_drvdata(dev_to_psy(dev));
+	__le32 artg;
+	int status;
+
+	status = ssam_retry(ssam_bat_get_artg, ac->sdev, &artg);
+	if (status)
+		return status;
+
+	if (le32_to_cpu(artg) == SPWR_AC_ARTG_UNKNOWN)
