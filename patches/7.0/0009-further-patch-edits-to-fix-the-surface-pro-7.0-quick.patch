 	ret = acpi_tic_reset(qsdev);
 	if (ret)
-		return ret;
+		dev_warn(qsdev->dev, "acpi_tic_reset returned %d, continuing...\n", ret);
 
 	ret = thc_interrupt_quiesce(qsdev->thc_hw, false);
 	if (ret)
@@ -294,8 +294,7 @@ int reset_tic(struct quickspi_device *qsdev)
 					       qsdev->reset_ack,
