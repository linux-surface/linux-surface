 	union acpi_object *obj;
 
 	obj = acpi_evaluate_dsm_typed(handle, guid, rev, func, NULL, type);
+	if (!obj && guid == &hidspi_guid)
+        obj = acpi_evaluate_dsm_typed(handle, &thc_quickspi_guid, rev, func, NULL, type);
+    if (!obj && rev > 0)
+        obj = acpi_evaluate_dsm_typed(handle, guid, 0, func, NULL, type);
 	if (!obj) {
 		acpi_handle_err(handle,
 				"Error _DSM call failed, rev: %llu, func: %llu, type: %u\n",
@@ -116,62 +120,49 @@ static int thc_acpi_get_property(struct acpi_device *adev, const guid_t *guid,
 static int quickspi_get_acpi_resources(struct quickspi_device *qsdev)
