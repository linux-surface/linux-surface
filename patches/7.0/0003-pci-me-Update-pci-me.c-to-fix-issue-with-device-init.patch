From 4ae53e53cb12f1f181a40bb9003024337ea67bd5 Mon Sep 17 00:00:00 2001
From: RowdyRagamuffin <stevenandree@outlook.com>
Date: Fri, 24 Jul 2026 00:28:52 +0800
Subject: [PATCH 3/5] pci-me: Update pci-me.c to fix issue with device
 initialization

---
 drivers/misc/mei/pci-me.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/misc/mei/pci-me.c b/drivers/misc/mei/pci-me.c
index caf9b8811..ab9eac4a3 100644
--- a/drivers/misc/mei/pci-me.c
+++ b/drivers/misc/mei/pci-me.c
@@ -18,6 +18,7 @@
 #include <linux/pm_runtime.h>
 
 #include <linux/mei.h>
+#define PCI_DEVICE_ID_INTEL_MEI_ICP_LP_3 0x34E0
 
 #include "mei_dev.h"
 #include "client.h"
@@ -98,7 +99,7 @@ static const struct pci_device_id mei_me_pci_tbl[] = {
 	{PCI_DEVICE_DATA(INTEL, MEI_CMP_H_3, MEI_ME_PCH8_ITOUCH_CFG)},
 
 	{PCI_DEVICE_DATA(INTEL, MEI_ICP_LP, MEI_ME_PCH12_CFG)},
-	{MEI_PCI_DEVICE(MEI_DEV_ID_ICL_3, MEI_ME_PCH12_CFG)},
+	{PCI_VDEVICE(INTEL, MEI_ICP_LP_3), (kernel_ulong_t)&MEI_ME_PCH12_CFG},
 	{PCI_DEVICE_DATA(INTEL, MEI_ICP_N, MEI_ME_PCH12_CFG)},
 
 	{PCI_DEVICE_DATA(INTEL, MEI_TGP_LP, MEI_ME_PCH15_CFG)},
